  - m_Id: 33403561468182528
    m_Localized: Spaltbreite verringeren
    m_Metadata:
      m_Items: []
  - m_Id: 33403608020762624
    m_Localized: 'Kurve anzeigen

      an/aus'
    m_Metadata:
      m_Items: []
  - m_Id: 33403720579104768
    m_Localized: "Spaltdistanz erh\xF6hen\n"
    m_Metadata:
      m_Items: []
  - m_Id: 33403779928506368
    m_Localized: Spaltdistanz verringern
    m_Metadata:
      m_Items: []
  - m_Id: 33403834353795072
    m_Localized: 'Interferenz anzeigen

      an/aus'
    m_Metadata:
      m_Items: []
  - m_Id: 33403926813032448
    m_Localized: "Wellenl\xE4nge erh\xF6hen\n"
    m_Metadata:
